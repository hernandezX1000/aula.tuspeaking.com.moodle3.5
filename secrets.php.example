<?php
/**
 * secrets.php.example — plantilla de credenciales externalizadas (tuSpeaking / aula Moodle 3.5)
 * ---------------------------------------------------------------------------------------------
 * QUÉ ES:
 *   Fichero central de credenciales para los scripts custom del repo que necesitan
 *   claves de API o de BD y que NO deben llevar el secreto en duro.
 *
 * CÓMO SE USA (en el SERVIDOR, nunca en git):
 *   1. cp secrets.php.example secrets.php
 *   2. Rellenar los valores reales (reemplazar cada 'CHANGE_ME').
 *   3. chown 33:33 secrets.php     # www-data:www-data dentro del contenedor (uid/gid 33)
 *      chmod 640 secrets.php       # solo el usuario web y su grupo lo leen
 *   4. Colocarlo en la RAÍZ de Moodle (junto a config.php).
 *
 * REGLAS:
 *   - secrets.php (con valores reales) está en .gitignore y NUNCA se versiona.
 *   - Este .example SÍ se versiona, pero solo con placeholders 'CHANGE_ME'.
 *   - La password de BD de Moodle se lee preferentemente de $CFG->dbpass en los
 *     scripts que hacen require('config.php'). Las constantes TS_DB_* de abajo son
 *     el fallback SOLO para scripts standalone que no bootstrapean Moodle.
 *   - Cada define() está guardado con if(!defined(...)) para poder incluir el fichero
 *     más de una vez sin warnings.
 */

// === Acuity Scheduling (API) ===
if (!defined('ACUITY_USER_ID'))        define('ACUITY_USER_ID', 'CHANGE_ME');   // p.ej. 15680788
if (!defined('ACUITY_API_KEY'))        define('ACUITY_API_KEY', 'CHANGE_ME');   // clave de API de Acuity

// === Password por defecto de cuentas demo (panel admin) ===
if (!defined('DEMO_DEFAULT_PASSWORD')) define('DEMO_DEFAULT_PASSWORD', 'CHANGE_ME');

// === Base de datos — SOLO para scripts standalone (sin $CFG de Moodle) ===
// Los scripts que hacen require('config.php') deben usar $CFG->dbhost/dbname/dbuser/dbpass.
if (!defined('TS_DB_HOST'))            define('TS_DB_HOST', 'localhost');
if (!defined('TS_DB_NAME'))            define('TS_DB_NAME', 'CHANGE_ME');       // p.ej. aulatuspeaking35
if (!defined('TS_DB_USER'))            define('TS_DB_USER', 'CHANGE_ME');       // p.ej. moodle35
if (!defined('TS_DB_PASS'))            define('TS_DB_PASS', 'CHANGE_ME');       // password de BD

// Nota: el JWT de Zoom está DEPRECADO. La ingesta usa S2S OAuth vía get_config('zoom')
// (config del plugin Zoom de Moodle). No se añaden aquí credenciales de Zoom.
